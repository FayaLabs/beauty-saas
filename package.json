{
  "name": "beauty-saas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5301 --strictPort",
    "dev:published-sdk": "node scripts/vite-with-sdk-source.mjs published dev",
    "typecheck": "tsc -p tsconfig.local.json --noEmit",
    "build": "tsc -p tsconfig.local.json && node scripts/vite-with-sdk-source.mjs local build",
    "build:published-sdk": "tsc -p tsconfig.published.json && node scripts/vite-with-sdk-source.mjs published build",
    "preview": "vite preview --port 5180",
    "test:gcal:unit": "node --test supabase/functions/_shared/google-calendar-security.test.mjs supabase/functions/_shared/google-calendar-mapping.test.mjs supabase/functions/_shared/google-calendar-runtime.test.mjs supabase/functions/google-calendar-webhook/webhook.test.mjs scripts/google-calendar-smoke.test.mjs",
    "test:gcal:edge": "node scripts/google-calendar-template-check.mjs && node scripts/google-calendar-bundle-check.mjs",
    "test:gcal:preflight": "node scripts/google-calendar-smoke.mjs --mode=preflight",
    "test:gcal:connected": "node scripts/google-calendar-smoke.mjs --mode=connected",
    "test:gcal": "npm run test:gcal:unit && npm run test:gcal:edge && npm run test:gcal:preflight",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:apply": "node scripts/db-apply.mjs",
    "prepare": "node scripts/prepare-git-hooks.mjs"
  },
  "dependencies": {
    "@fayz-ai/auth": "^0.9.0",
    "@fayz-ai/core": "^0.9.0",
    "@fayz-ai/db": "^0.9.0",
    "@fayz-ai/plugin-agenda": "^0.9.0",
    "@fayz-ai/plugin-crm": "^0.9.0",
    "@fayz-ai/plugin-dashboard": "^0.9.0",
    "@fayz-ai/plugin-financial": "^0.9.0",
    "@fayz-ai/plugin-forms": "^0.9.0",
    "@fayz-ai/plugin-inventory": "^0.9.0",
    "@fayz-ai/plugin-marketing": "^0.9.0",
    "@fayz-ai/plugin-reports": "^0.9.0",
    "@fayz-ai/plugin-tasks": "^0.9.0",
    "@fayz-ai/saas": "^0.9.0",
    "@fayz-ai/sdk": "^0.9.0",
    "@fayz-ai/ui": "^0.9.0",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "sonner": "^2.0.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@fayz-ai/cli": "^0.8.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.5"
  }
}
